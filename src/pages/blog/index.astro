---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

let allPosts: any[] = []
try {
  allPosts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
} catch {
  // Collection might not exist yet
}

// Group series articles — use seriesOrder:0 article as the column card
const seriesMap = new Map<string, any[]>()
const standalonePosts: any[] = []

for (const post of allPosts) {
  if (post.data.series) {
    const arr = seriesMap.get(post.data.series) ?? []
    arr.push(post)
    seriesMap.set(post.data.series, arr)
  } else {
    standalonePosts.push(post)
  }
}

// Build column entries — one card per series, sorted by latest date
const columnEntries: { seriesId: string; cover: any; articles: any[]; latestDate: Date }[] = []
for (const [seriesId, articles] of seriesMap) {
  articles.sort((a, b) => (a.data.seriesOrder ?? 99) - (b.data.seriesOrder ?? 99))
  const cover = articles[0]
  const latestDate = articles.reduce((d, p) => {
    const pd = new Date(p.data.date)
    return pd > d ? pd : d
  }, new Date(0))
  columnEntries.push({ seriesId, cover, articles, latestDate })
}
columnEntries.sort((a, b) => b.latestDate.getTime() - a.latestDate.getTime())

// Merge columns and standalone posts in date order for the feed
type FeedItem =
  | { type: 'column'; entry: typeof columnEntries[0]; date: Date }
  | { type: 'post'; post: any; date: Date }

const feed: FeedItem[] = [
  ...columnEntries.map(e => ({ type: 'column' as const, entry: e, date: e.latestDate })),
  ...standalonePosts.map(p => ({ type: 'post' as const, post: p, date: new Date(p.data.date) })),
].sort((a, b) => b.date.getTime() - a.date.getTime())

const categories = ['全部', ...new Set(standalonePosts.map((p: any) => p.data.category).filter(Boolean))]
---

<BaseLayout title="博客" showSearch={true}>
  <div class="space-y-8 animate-fade-in">
    <header class="space-y-4">
      <h1 class="text-3xl font-bold" data-zh="博客" data-en="Blog">博客</h1>
      <p class="text-gray-600 dark:text-gray-400" data-zh="记录技术学习和生活思考" data-en="Recording tech learning and life thoughts">
        记录技术学习和生活思考
      </p>
    </header>

    {categories.length > 1 && (
      <div class="flex flex-wrap gap-2">
        {categories.map((cat, index) => (
          <button
            class:list={[
              'px-3 py-1 text-sm rounded-full transition-colors',
              index === 0
                ? 'bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900'
                : 'bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700'
            ]}
          >
            {cat}
          </button>
        ))}
      </div>
    )}

    {feed.length > 0 ? (
      <div class="space-y-6">
        {feed.map((item) => item.type === 'column' ? (
          // — Column card —
          <a
            href={`/series/${item.entry.seriesId}/`}
            class="block group"
            data-post-title={item.entry.cover.data.title}
            data-post-description={item.entry.cover.data.description || ''}
          >
            <div class="p-6 -mx-6 rounded-xl border border-blue-100 dark:border-blue-900/40 bg-blue-50/40 dark:bg-blue-950/20 hover:border-blue-300 dark:hover:border-blue-700 hover:bg-blue-50 dark:hover:bg-blue-950/40 transition-all">
              <div class="flex items-start gap-3">
                <div class="shrink-0 mt-0.5">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-blue-600 text-white">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                    专栏
                  </span>
                </div>
                <div class="flex-1 min-w-0 space-y-2">
                  <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                    {item.entry.cover.data.title}
                  </h2>
                  {item.entry.cover.data.description && (
                    <p class="text-gray-600 dark:text-gray-400 line-clamp-2 text-sm">
                      {item.entry.cover.data.description}
                    </p>
                  )}
                  <ul class="space-y-1 pt-1">
                    {item.entry.articles.slice(1).map((article: any) => (
                      <li class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
                        <span class="w-1 h-1 rounded-full bg-gray-400 shrink-0" />
                        <span class="truncate">{article.data.title}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="flex items-center gap-3 text-xs text-gray-400 dark:text-gray-500 pt-1">
                    <time>{item.date.toLocaleDateString('zh-CN')}</time>
                    <span>{item.entry.articles.length - 1} 篇文章</span>
                  </div>
                </div>
                <svg class="w-4 h-4 text-gray-400 group-hover:text-blue-500 shrink-0 mt-1 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>
        ) : (
          // — Regular post —
          <article
            class="group"
            data-post-title={item.post.data.title}
            data-post-description={item.post.data.description || ''}
          >
            <a
              href={`/blog/${item.post.slug}`}
              class="block p-6 -mx-6 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-900/50 transition-colors"
            >
              <div class="flex items-start justify-between gap-4">
                <div class="space-y-2">
                  <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                    {item.post.data.title}
                  </h2>
                  {item.post.data.description && (
                    <p class="text-gray-600 dark:text-gray-400 line-clamp-2">
                      {item.post.data.description}
                    </p>
                  )}
                  <div class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400">
                    <time>{new Date(item.post.data.date).toLocaleDateString('zh-CN')}</time>
                    {item.post.data.category && (
                      <span class="px-2 py-0.5 bg-gray-100 dark:bg-gray-800 rounded">
                        {item.post.data.category}
                      </span>
                    )}
                  </div>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="p-12 bg-gray-50 dark:bg-gray-900 rounded-xl text-center">
        <svg class="w-16 h-16 mx-auto text-gray-300 dark:text-gray-700 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        <p class="text-gray-500 dark:text-gray-400" data-zh="博客内容正在甄选中，敬请期待精选好文..." data-en="Posts are being curated, stay tuned for selected highlights...">
          博客内容正在甄选中，敬请期待精选好文...
        </p>
      </div>
    )}
  </div>
</BaseLayout>
